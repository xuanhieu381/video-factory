# Chép thành .env (không đưa .env lên git). Mọi dòng đều tuỳ chọn.

# Thương hiệu mặc định khi job không ghi "thuongHieu" (thư mục trong public/thuong-hieu/)
THUONG_HIEU=mau

# Giọng đọc AI cho video đồ hoạ
FPT_API_KEY=
FPT_VOICE=banmai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# whisper.cpp đã cài sẵn ở chỗ khác (mặc định: ./whisper.cpp do `npm run cai-dat` tạo)
WHISPER_DIR=

# Repo nằm trên ổ exFAT (không có symlink): đặt Chrome headless ở ổ trong và trỏ tới đây
CHROME_HEADLESS=

# Cổng server render (mặc định 3910)
REMOTION_RENDER_PORT=
